@startuml
title Jira -> GitHub Issue -> Copilot Agent -> PR -> Review -> Merge

skinparam backgroundColor white
skinparam shadowing false
skinparam sequence {
  ArrowColor #2F5D62
  LifeLineBorderColor #5B7C99
  LifeLineBackgroundColor #F7FAFC
  ParticipantBorderColor #5B7C99
  ParticipantBackgroundColor #EDF2F7
  ParticipantFontColor #1A202C
  ActorBorderColor #2D3748
  ActorBackgroundColor #FFF5F5
  ActorFontColor #1A202C
  GroupBorderColor #A0AEC0
  GroupBackgroundColor #F7FAFC
}

autonumber

actor "Product Owner\n/ Jira User" as User
participant "Jira" as Jira
participant "Jira Automation" as JiraAutomation
participant "GitHub Actions\njira-to-issue.yml" as JiraToIssue
participant "GitHub Issues API" as IssuesApi
participant "GitHub Agents API" as AgentsApi
participant "Copilot Cloud Agent" as Agent
participant "Agent Runtime\n(branch + commits)" as Runtime
participant "GitHub Pull Request" as PR
actor Reviewer
participant "GitHub Actions\npr-opened-jira-in-review.yml" as PrReviewWorkflow
participant "GitHub Actions\npr-merged-jira-done.yml" as PrMergedWorkflow
participant "GitHub Git Refs API" as GitRefsApi

User -> Jira : Refine ticket with description\nand acceptance criteria
User -> Jira : Move ticket to "Selected for Development"
Jira -> JiraAutomation : Ticket reaches ready-for-dev state

group Ticket to Issue Automation
  JiraAutomation -> JiraToIssue : repository_dispatch\n(type: jira-ready-for-dev, payload with Jira key/url/summary/AC)
  activate JiraToIssue
  JiraToIssue -> JiraToIssue : Normalize acceptance criteria\nand build issue body
  JiraToIssue -> IssuesApi : Validate GH_ISSUE_TOKEN via /user
  IssuesApi --> JiraToIssue : Authenticated GitHub user
  JiraToIssue -> AgentsApi : Check task API access\n(GET /agents/repos/{owner}/{repo}/tasks)
  AgentsApi --> JiraToIssue : Task API available
  JiraToIssue -> IssuesApi : Create GitHub issue\n(title includes Jira key, assignee = token user)
  IssuesApi --> JiraToIssue : Issue number, node id, URL
  JiraToIssue -> AgentsApi : Start Copilot task\n(base_ref = default branch, create_pull_request = true)
  AgentsApi --> JiraToIssue : Task id, task URL, state
  JiraToIssue -> IssuesApi : Comment on issue with task URL
  JiraToIssue -> Jira : Transition ticket to "In Progress" (31)
  JiraToIssue --> JiraAutomation : Workflow success
  deactivate JiraToIssue
end

alt Token or task API check fails
  JiraToIssue --> JiraAutomation : Workflow fails before Jira transition
  note over JiraToIssue,Jira
    Jira is only moved to In Progress after
    both the GitHub issue and the Copilot task exist.
  end note
else Agent task created successfully
  AgentsApi -> Agent : Provision cloud-agent task
  activate Agent
  Agent -> Runtime : Create working branch from default branch
  activate Runtime
  Runtime -> IssuesApi : Read linked GitHub issue\nand implementation instructions
  Runtime -> Runtime : Implement changes
  Runtime -> Runtime : Add or update tests
  Runtime -> Runtime : Commit changes to branch
  Runtime -> PR : Open pull request\n(closes issue, references Jira key)
  deactivate Runtime
  Agent --> AgentsApi : Task reaches PR-created state
  deactivate Agent
end

group PR opened and handed to reviewer
  PR -> Reviewer : Review requested
  PR -> PrReviewWorkflow : pull_request_target\n(type: review_requested)
  activate PrReviewWorkflow
  PrReviewWorkflow -> PrReviewWorkflow : Extract Jira key from PR title\nor fallback to PR body
  alt Jira key found
    PrReviewWorkflow -> Jira : Add comment with PR link, PR body,\nand reviewer validation plan
    PrReviewWorkflow -> Jira : Transition ticket to "In Review" (81)
  else Jira key missing
    PrReviewWorkflow -> PrReviewWorkflow : Log warning and exit without Jira change
  end
  deactivate PrReviewWorkflow
end

group Human review and merge
  Reviewer -> PR : Review diff, tests, acceptance criteria
  Reviewer -> PR : Approve and merge
  PR -> PrMergedWorkflow : pull_request_target\n(type: closed, merged = true)
  activate PrMergedWorkflow
  PrMergedWorkflow -> PrMergedWorkflow : Extract Jira key from PR title\nor fallback to PR body
  alt Jira key found
    PrMergedWorkflow -> Jira : Add merged-PR comment
    PrMergedWorkflow -> Jira : Transition ticket to "Done" (41)
    PrMergedWorkflow -> GitRefsApi : Delete merged head branch
  else Jira key missing
    PrMergedWorkflow -> PrMergedWorkflow : Log warning and exit without Jira change
  end
  deactivate PrMergedWorkflow
end

note over Jira,PR
  Implemented workflow files:
  - .github/workflows/jira-to-issue.yml
  - .github/workflows/pr-opened-jira-in-review.yml
  - .github/workflows/pr-merged-jira-done.yml
end note

@enduml